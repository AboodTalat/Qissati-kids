# The public website origin used for canonical URLs, hreflang, the sitemap,
# robots.txt and structured data. Set the final HTTPS origin in production,
# with no path or trailing slash (for example: https://your-domain.example).
NEXT_PUBLIC_SITE_URL=

# Optional ownership tokens from Google Search Console and Bing Webmaster
# Tools. Leave empty until each service gives you the exact token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# The qissati API base URL, including its /qissati mount.
#   local:      http://localhost:5000/qissati
#   production: https://<render-service>.onrender.com/qissati
# Empty = no backend: prices render `[X]` and the order form falls back to the
# WhatsApp-only path.
NEXT_PUBLIC_QISSATI_API=

# The PIN that unlocks /admin, in front of the dashboard's own email+password
# sign-in. Not NEXT_PUBLIC_ on purpose: a NEXT_PUBLIC_ value is inlined into
# the JavaScript bundle in cleartext, so it would ship the PIN to exactly the
# people it is meant to keep out. Everything about it stays server-side.
#
# Empty = no gate. That is a real, deliberate fallback: the password login
# behind it is the actual security, so an unset PIN leaves the dashboard as
# safe as it was before the gate existed — while failing closed would lock the
# team out of their own orders over a forgotten variable. Set it in production.
#
# Use a passphrase, not four digits. The unlock cookie is HMAC-signed with the
# PIN as the key, so anyone who ever sees a cookie value can brute-force a
# short PIN offline; the server-side rate limit only covers online guessing,
# and it is per-instance. Changing this value re-locks every device.
ADMIN_GATE_PIN=
